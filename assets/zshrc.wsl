# ─────────────────────────────────────────────────────────────────────────────
# devterm — @skaisser style zshrc
# https://github.com/skaisser/devterm
# ─────────────────────────────────────────────────────────────────────────────

# ── History ───────────────────────────────────────────────────────────────────
[[ ! -d ~/.zsh ]] && mkdir -p ~/.zsh
HISTFILE=~/.zsh/.zsh_history
HISTSIZE=1000000
SAVEHIST=1000000
setopt APPEND_HISTORY SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS HIST_VERIFY EXTENDED_HISTORY

# ── Terminal ──────────────────────────────────────────────────────────────────
export LANG="en_US.UTF-8"
export EDITOR='code'
unsetopt BEEP
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PROMPT_SUBST

# ── Completion ────────────────────────────────────────────────────────────────
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# ── PATH ──────────────────────────────────────────────────────────────────────
PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

path_additions=(
    "$HOME/.local/bin"
    "/usr/local/bin"
    "$HOME/.fzf/bin"
    "$HOME/.bun/bin"
)
for d in "${path_additions[@]}"; do [ -d "$d" ] && PATH="$d:$PATH"; done
typeset -U PATH

# ── Laravel Herd (PHP + NVM) ──────────────────────────────────────────────────
if [[ -d "/Applications/Herd.app" ]]; then
    export NVM_DIR="$HOME/Library/Application Support/Herd/config/nvm"
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    [[ -f "/Applications/Herd.app/Contents/Resources/config/shell/zshrc.zsh" ]] && \
        builtin source "/Applications/Herd.app/Contents/Resources/config/shell/zshrc.zsh"
else
    # ── nvm (standalone — lazy-loaded for fast startup) ────────────────────────
    export NVM_DIR="$HOME/.nvm"
    _lazy_load_nvm() {
        unset -f node npm npx nvm
        [[ -s "$NVM_DIR/nvm.sh" ]] && \. "$NVM_DIR/nvm.sh"
    }
    for _nvm_cmd in node npm npx nvm; do
        eval "${_nvm_cmd}() { _lazy_load_nvm; ${_nvm_cmd} \"\$@\"; }"
    done
    unset _nvm_cmd
fi

# ── Aliases — Navigation ──────────────────────────────────────────────────────
alias cl="clear"
alias -- -="cd -"
alias ..="cd .."
alias ..2="cd ../.."
alias ..3="cd ../../.."
alias ..4="cd ../../../.."
alias ..5="cd ../../../../.."
alias sites="cd ~/Sites"
export CDPATH=".:$HOME/Sites"

# ── Aliases — Git ─────────────────────────────────────────────────────────────
alias gst="git status"
alias gco="git checkout"
alias gcb="git checkout -b"
alias gadd="git add -p"           # interactive add — pick hunks to stage
alias glog="git log --oneline --graph --decorate"
alias gd="git diff"
alias gds="git diff --staged"
alias gp="git pull"
alias gpush="git push origin"

# ── Aliases — PHP / Laravel ───────────────────────────────────────────────────
alias art="php artisan"
alias pt="./vendor/bin/pest"
alias ptp="./vendor/bin/pest --parallel --processes=10"
alias tc="herd coverage ./vendor/bin/pest --coverage"
alias tcq="herd coverage ./vendor/bin/pest --coverage --parallel --processes=10"
alias cda="composer dump-autoload"

if [[ -d "/Applications/Herd.app" ]]; then
    alias hfix="herd restart && echo 'Herd restarted'"
fi

# ── Aliases — Claude Code ─────────────────────────────────────────────────────
if command -v claude &>/dev/null; then
    alias claudd="claude --dangerously-skip-permissions"
fi

# ── Aliases — Directory listing (eza) ─────────────────────────────────────────
if command -v eza &>/dev/null; then
    alias ls="eza --icons --git"
    alias l="eza -l --icons --git -a"
    alias ll="eza -la --icons --git"
    alias lt="eza --tree --level=2 --long --icons --git"
    alias ltree="eza --tree --level=2 --icons --git"
else
    alias ls="ls --color=auto"
    alias l="ls -l --color=auto"
    alias ll="ls -la --color=auto"
fi

command -v tree &>/dev/null && alias la="tree"

# ── Aliases — System ──────────────────────────────────────────────────────────
alias mkdir="mkdir -p"
alias df="df -h"
alias du="du -h"
alias dud="du -d 1 -h"           # disk usage one level deep
alias duf="du -sh *"             # disk usage of each item in current dir
alias grep="grep --color=auto"
alias psa="ps aux"
alias ports="lsof -i -P -n | grep LISTEN"

# ── Functions ─────────────────────────────────────────────────────────────────

# Create and enter directory in one step
mkcd() { mkdir -p "$1" && cd "$1"; }

# Extract any archive format — just: extract file.tar.gz
extract() {
    if [ -f "$1" ]; then
        case "$1" in
            *.tar.bz2) tar xjf "$1" ;;
            *.tar.gz)  tar xzf "$1" ;;
            *.tar.xz)  tar xJf "$1" ;;
            *.bz2)     bunzip2 "$1" ;;
            *.rar)     unrar e "$1" ;;
            *.gz)      gunzip "$1" ;;
            *.tar)     tar xf "$1" ;;
            *.tbz2)    tar xjf "$1" ;;
            *.tgz)     tar xzf "$1" ;;
            *.zip)     unzip "$1" ;;
            *.Z)       uncompress "$1" ;;
            *.7z)      7z x "$1" ;;
            *) echo "'$1' cannot be extracted via extract()" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

# Search processes by name — psg nginx
psg() { ps aux | grep -v grep | grep -i "$1"; }

# Kill process by name — killp nginx (with confirmation)
killp() {
    if [[ -z "$1" ]]; then echo "Usage: killp <process_name>"; return 1; fi
    local pids=($(pgrep -f "$1"))
    if [[ ${#pids[@]} -eq 0 ]]; then echo "No matching processes"; return 1; fi
    ps -p "${pids[@]}" -o pid,command
    echo -n "Kill these? [y/N] "
    read -r confirm
    [[ "$confirm" == [yY] ]] && kill -9 "${pids[@]}"
}

# Quick weather — weather "London" or just: weather
weather() {
    local city="${1:-New York}"
    curl -s "wttr.in/${city}?format=3"
}

# Top memory consumers
memusage() { ps aux | sort -nk 4 | tail; }

# Top CPU consumers
cpuusage() { ps aux | sort -nk 3 | tail; }

# ── Windows Terminal: cor de fundo por janela + modo perigo no SSH ───────────
# Adaptado do bloco iTerm2 do devterm (skaisser). O Windows Terminal aceita
# trocar o fundo pela sequência OSC 11; não tem cor de aba por sequência.
if [[ -n "$WT_SESSION" ]]; then

    _wt_set_bg_color() {
        local hex="$1"
        [[ "$hex" == "$_WT_LAST_BG" ]] && return
        _WT_LAST_BG="$hex"
        printf '\033]11;#%s\a' "$hex"
    }

    _wt_auto_colors() {
        local bg_colors=(
            "1e2040"    # azul-marinho
            "1a2a1a"    # verde-floresta
            "2a1818"    # vinho
            "1a1a38"    # índigo
            "0f2828"    # azul-petróleo
            "1a0e2a"    # ameixa
            "261426"    # violeta
            "0e2a1a"    # esmeralda
        )
        local tty_num
        tty_num=$(tty | tr -dc '0-9' | tail -c 3)
        tty_num=${tty_num:-0}
        local idx=$(( (tty_num % ${#bg_colors[@]}) + 1 ))
        _wt_set_bg_color "${bg_colors[$idx]}"
    }

    _wt_short_cwd() {
        if [[ "$PWD" == "$HOME"* ]]; then echo "~${PWD#$HOME}"; else echo "$PWD"; fi
    }

    _wt_build_title() {
        local title="📂 $(_wt_short_cwd)"
        if git rev-parse --git-dir &>/dev/null 2>&1; then
            local branch
            branch=$(git --no-optional-locks branch --show-current 2>/dev/null)
            [[ -z "$branch" ]] && branch=$(git --no-optional-locks rev-parse --short HEAD 2>/dev/null)
            if [[ -n "$branch" ]]; then
                title+="  $branch"
                local working staged ahead behind
                working=$(git --no-optional-locks diff --numstat 2>/dev/null | wc -l | tr -d ' ')
                staged=$(git --no-optional-locks diff --cached --numstat 2>/dev/null | wc -l | tr -d ' ')
                ahead=$(git --no-optional-locks rev-list --count @{upstream}..HEAD 2>/dev/null)
                behind=$(git --no-optional-locks rev-list --count HEAD..@{upstream} 2>/dev/null)
                [[ "$working" -gt 0 ]] && title+=" ~$working"
                [[ "$staged"  -gt 0 ]] && title+=" +$staged"
                [[ "$ahead"   -gt 0 ]] && title+=" ↑$ahead"
                [[ "$behind"  -gt 0 ]] && title+=" ↓$behind"
            fi
        fi
        echo "$title"
    }

    _wt_precmd() {
        if [[ -z "$_WT_IN_SSH" ]]; then
            echo -ne "\033]0;$(_wt_build_title)\a"
            _wt_auto_colors
        fi
    }

    autoload -Uz add-zsh-hook
    add-zsh-hook precmd _wt_precmd
    _wt_auto_colors

    # SSH: fundo vermelho enquanto estiver num servidor
    ssh() {
        local host="" skip=false arg
        for arg in "$@"; do
            if $skip; then skip=false; continue; fi
            case "$arg" in
                -[bcDEeFIiJLlmOopQRSWw]) skip=true ;;
                -*) ;;
                *@*) host="${arg#*@}"; break ;;
                *)   [[ -z "$host" ]] && host="$arg"; break ;;
            esac
        done
        _wt_set_bg_color "3a0808"
        _WT_IN_SSH=1
        echo -ne "\033]0;🔴 SSH → ${host%%.*}\a"
        command ssh "$@"
        unset _WT_IN_SSH
        _WT_LAST_BG=""
        _wt_auto_colors
        echo -ne "\033]0;$(_wt_build_title)\a"
    }
fi

# ── Oh My Posh ────────────────────────────────────────────────────────────────
if command -v oh-my-posh &>/dev/null && [[ "$TERM_PROGRAM" != "Apple_Terminal" ]]; then
    [[ ! -d ~/.zsh/themes ]] && mkdir -p ~/.zsh/themes
    if [[ -f ~/.zsh/themes/skaisser.omp.json ]]; then
        eval "$(oh-my-posh init zsh --config ~/.zsh/themes/skaisser.omp.json)"
    else
        eval "$(oh-my-posh init zsh)"
    fi
fi

# ── Plugins ───────────────────────────────────────────────────────────────────
# fpath additions must come before compinit
[[ -d ~/.zsh/plugins/zsh-completions/src ]] && fpath=(~/.zsh/plugins/zsh-completions/src $fpath)
autoload -Uz compinit
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
    compinit
else
    compinit -C
fi

# fzf — fuzzy finder (Ctrl+R history · Ctrl+T files · Alt+C cd into dir)
if command -v fzf &>/dev/null; then
    source <(fzf --zsh)
    export FZF_DEFAULT_OPTS="--height=40% --layout=reverse --border --info=inline"
    export FZF_CTRL_T_OPTS="--preview 'head -100 {}'"
fi

# History substring search — type partial command then press Up/Down
[[ -f ~/.zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh ]] && {
    source ~/.zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh
    bindkey '^[[A' history-substring-search-up
    bindkey '^[[B' history-substring-search-down
}

# Auto-suggestions — grey hint as you type, press Right arrow to accept
[[ -f ~/.zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && {
    source ~/.zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
    ZSH_AUTOSUGGEST_STRATEGY=(history completion)
    ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=244'
}

# Syntax highlighting — red for invalid commands, green for valid (load last)
[[ -f ~/.zsh/plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh ]] && \
    source ~/.zsh/plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh

# zoxide — frecency directory jumper: "z myapp" to jump, "zi" for interactive
command -v zoxide &>/dev/null && eval "$(zoxide init zsh)"

# ── Local overrides ───────────────────────────────────────────────────────────
# Machine-specific config — never tracked in version control
# Great place for: 1Password, API keys, work-specific aliases
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
